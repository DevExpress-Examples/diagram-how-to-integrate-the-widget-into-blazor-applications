<Project Sdk="Microsoft.NET.Sdk.Web">
  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
	<NodeModulesDir>$(ProjectDir)node_modules\</NodeModulesDir>
	<WwwRootDir>$(ProjectDir)wwwroot\</WwwRootDir>
  </PropertyGroup>

	<Target Name="DebugEnsureNodeEnv" BeforeTargets="BeforeBuild" Condition=" '$(Configuration)' == 'Debug' ">
		<Exec Command="node --version" ContinueOnError="true">
			<Output TaskParameter="ExitCode" PropertyName="ErrorCode" />
		</Exec>
		<Error Condition="'$(ErrorCode)' != '0'" Text="Node.js is required to build and run this project. To continue, please install Node.js from https://nodejs.org/, and then restart your command prompt or IDE." />
		<Message Importance="high" Text="Restoring dependencies using 'npm'. This may take several minutes..." />
		<Exec WorkingDirectory="$(SpaRoot)" Command="npm install" />
	</Target>

	<Target Name="CopyFilesFromNodeModules" BeforeTargets="Build">
		<ItemGroup>
			<ScriptFiles Include="$(NodeModulesDir)jquery\dist\jquery.min.js"></ScriptFiles>
			<ScriptFiles Include="$(NodeModulesDir)devextreme-dist\js\dx.all.js"></ScriptFiles>
			<ScriptFiles Include="$(NodeModulesDir)devexpress-diagram\dist\dx-diagram.min.js"></ScriptFiles>
		</ItemGroup>
		<ItemGroup>
			<StyleFiles Include="$(NodeModulesDir)devextreme-dist\css\dx.fluent.blue.light.css" />
			<StyleFiles Include="$(NodeModulesDir)devexpress-diagram\dist\dx-diagram.min.css" />
		</ItemGroup>
		<ItemGroup>
			<FontFiles Include="$(NodeModulesDir)devextreme-dist\css\icons\dxiconsfluent.woff"></FontFiles>
			<FontFiles Include="$(NodeModulesDir)devextreme-dist\css\icons\dxiconsfluent.woff2"></FontFiles>
			<FontFiles Include="$(NodeModulesDir)devextreme-dist\css\icons\dxiconsfluent.ttf"></FontFiles>
		</ItemGroup>
		<Copy SourceFiles="@(ScriptFiles)" DestinationFolder="$(WwwRootDir)js\%(RecursiveDir)" SkipUnchangedFiles="true" />
		<Copy SourceFiles="@(StyleFiles)" DestinationFolder="$(WwwRootDir)css\%(RecursiveDir)" SkipUnchangedFiles="true" />
		<Copy SourceFiles="@(FontFiles)" DestinationFolder="$(WwwRootDir)css\icons\%(RecursiveDir)" SkipUnchangedFiles="true" />
	</Target>
	
  <ItemGroup>
    <Content Include="DevExtremeComponents\DevExtremeDiagram.razor.js" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="DevExpress.Blazor" Version="25.2.*" />
  </ItemGroup>
</Project>